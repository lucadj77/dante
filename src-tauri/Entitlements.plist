<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- On macOS 10.15 Dante restarts itself with DYLD_VERSIONED_FRAMEWORK_PATH, to draw its
	     window with the WebKit of the updated Safari (src/webkit.rs). The hardened runtime
	     ignores that variable, and refuses the staged frameworks, without these two. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
