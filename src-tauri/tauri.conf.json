{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dante",
  "version": "0.1.0",
  "identifier": "app.dante.writer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dante",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "dante"
        ],
        "name": "Dante project",
        "description": "Dante project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-dante-project",
        "contentTypes": [
          "app.dante.writer.project"
        ],
        "exportedType": {
          "identifier": "app.dante.writer.project",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/dante.desktop",
        "files": {
          "/usr/share/mime/packages/dante.xml": "linux/dante-mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/dante.desktop",
        "files": {
          "/usr/share/mime/packages/dante.xml": "linux/dante-mime.xml"
        }
      }
    }
  }
}
